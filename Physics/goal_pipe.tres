[gd_resource type="PhysicsMaterial" format=3]

; Goal frame pipe (posts, crossbar, mouth bends). Painted steel: slick and
; lively. Bounce sits above the boards (0.4) so the puck pings off the iron
; harder than off the glass — the iconic "off the post" — while friction sits
; below the boards (0.3) so it slides off cleanly. The puck carries no physics
; material (engine default: friction 1.0, bounce 0.0, both smooth), so the
; combine collapses to this surface: bounce ADDs (0 + 0.55) and friction takes
; the min (min(1.0, 0.15)). See GameRules ICE_FRICTION doc-block for the rule.
[resource]
friction = 0.15
bounce = 0.55
