[gd_resource type="PhysicsMaterial" format=3]

; Goal net panels + skirt rails (everything on HockeyGoal._net_body). Twine and
; slack fabric: it absorbs the shot and the puck drops to the ice. Near-zero
; bounce (a hair above 0 so the puck doesn't glue to the mesh) also masks the
; net panels' approximate box colliders — a dead puck dropping off imperfect
; geometry reads fine where a bouncy one would carom weirdly. High friction so
; the twine grabs. Combine vs. the material-less puck: bounce 0 + 0.05, friction
; min(1.0, 0.6). See GameRules ICE_FRICTION doc-block for the combine rule.
[resource]
friction = 0.6
bounce = 0.05
