[configuration]

entry_symbol = "mitts_native_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://native/bin/libmitts_native.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/bin/libmitts_native.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://native/bin/libmitts_native.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/bin/libmitts_native.windows.template_release.x86_64.dll"
macos.debug = "res://native/bin/libmitts_native.macos.template_debug.framework"
macos.release = "res://native/bin/libmitts_native.macos.template_release.framework"
