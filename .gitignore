# Godot
.godot/
*.translation
*.tmp

# Export
*.exe
*.pck
build/

# Steam build staging (SteamPipe content + logs; scripts are tracked)
steam/content/
steam/output/

# OS
.DS_Store
Thumbs.db
# GDExtension build output (every machine builds its own — native/README.md)
native/bin/
native/.sconsign.dblite
native/src/*.o
native/src/*.os
native/src/*.obj

# Godot's Windows DLL-lock workaround: when a GDExtension binary is held open,
# the editor hot-reloads from a tilde-prefixed shadow copy beside the original.
~*.dll
