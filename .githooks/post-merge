#!/bin/bash
# Warns after a pull/merge when the built GDExtension belongs to other sources.
#
# The check itself lives in native-stale-check.sh, shared with post-checkout: it
# compares the binary's own build stamp against the working tree, so it covers
# any way HEAD moved rather than the one range this hook can see.

exec "$(dirname "$0")/native-stale-check.sh"
